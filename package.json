{
  "name": "oh-my-deepseek",
  "version": "1.2.0",
  "description": "macOS desktop client for the local DeepSeek Harness (Electron + TypeScript)",
  "main": "out/main.js",
  "author": "douzhenyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/douzhenyu/oh-my-deepseek.git"
  },
  "homepage": "https://github.com/douzhenyu/oh-my-deepseek",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "generate-icon": "npm run build && node out/scripts/generate-icon.js && bash scripts/make-icns.sh",
    "check-compat": "npm run build && node out/scripts/check-harness-compat.js",
    "pack": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.dou.deepseek-desktop",
    "productName": "DeepSeek",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "loading.html",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "identity": null
    }
  }
}
